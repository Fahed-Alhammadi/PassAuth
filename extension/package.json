{
  "name": "passauth-extension",
  "private": true,
  "license": "MIT",
  "version": "0.17.2",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "wasm": "../scripts/build-wasm.sh extension/src/wasm",
    "build": "tsc -b && node build.mjs",
    "build:firefox": "tsc -b && node build.mjs --firefox",
    "build:safari": "tsc -b && node build.mjs --safari",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "package": "node build.mjs && node package.mjs",
    "package:firefox": "node build.mjs --firefox && node package.mjs --firefox"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  }
}
