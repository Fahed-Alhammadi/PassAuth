{
  // The service worker: no DOM (WebWorker globals), chrome.* APIs.
  "extends": "./base.json",
  "compilerOptions": {
    "outDir": "../node_modules/.cache/tsc/worker",
    "tsBuildInfoFile": "../node_modules/.cache/tsc/worker.tsbuildinfo",
    "lib": ["ES2023", "WebWorker"],
    "types": ["chrome"]
  },
  "include": ["../src/background", "../src/shared/*.ts", "../src/wasm/*.d.ts"],
  "references": [{ "path": "./web.json" }]
}
