<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline changes: sent when the connection comes back (ConnectivityManager callback). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Keeps other apps' overlay windows off PassAuth's consent sheets (save, passkeys, unlock over another app). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Only to scan authenticator QR codes, requested when the user taps "Scan QR code". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Sign-in request notifications, asked for when the user turns them on (vault card, Settings, first launch). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No advertising id: Firebase is used for messaging only (no analytics). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Browsers must be visible to check their signing certificates against the privileged allowlist (autofill).
         Apps with a launcher icon must be visible for their names: a login saved from an app is named after
         it, and passkey prompts say which app asks (else Android hides them and the package name shows). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Browsers with Custom Tabs / Auth Tab: two-step sign-in opens the server's key page in one. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".PassAuthApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.PassAuth">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Two-step sign-in with a security key: the server's key page returns here (passauth://two-step-key)
             when the browser has no Auth Tab. Forwards only to a sign-in waiting for it, then finishes:
             no UI, own empty task affinity, never in recents (no task hijacking). -->
        <activity
            android:name=".TwoStepKeyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="passauth" android:host="two-step-key" />
            </intent-filter>
        </activity>

        <!-- Settings activity of the autofill service and the passkey provider: opens Settings → Autofill. -->
        <activity-alias
            android:name=".AutofillSettings"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity" />

        <!-- Started only through PendingIntents from PassAuth's autofill and credential services.
             They handle configuration changes themselves: their request state lives in the activity,
             and recreating it (rotation, dark mode, font size, folding) would lose the request. -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.PassAuth.Service" />
        <activity
            android:name=".credentials.CredentialActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.PassAuth.Service" />

        <!-- Decrypted attachment copies for Open and Share (the cache's attachments/ folder only; read access granted per file). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Clears a copied secret after the delay if the app's process was stopped first (alarm, not exported). -->
        <receiver
            android:name=".data.ClipboardHelper$ClearReceiver"
            android:exported="false" />

        <service
            android:name=".autofill.PassAuthAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <service
            android:name=".credentials.PassAuthCredentialService"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- Sign-in request notifications (FCM, data-only messages from the PassAuth push relay).
             Firebase is initialised by hand from BuildConfig (PushCenter), so its init provider goes,
             and nothing is collected: no automatic token, no analytics, no data collection. -->
        <service
            android:name=".push.PassAuthMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_data_collection_default_enabled" android:value="false" />
        <meta-data android:name="delivery_metrics_exported_to_big_query_enabled" android:value="false" />
    </application>
</manifest>
