<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: the light gradient of the iOS icon. No night variant: launchers cache the icon
     drawn at install time, so it wouldn't follow the theme. Themes use the monochrome layer (themed icons). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="@color/launcher_background_top" android:endColor="@color/launcher_background_bottom" />
</shape>
