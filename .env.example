PUID=1000
PGID=1000
PASSAUTH_ADMIN_USERNAME=admin
PASSAUTH_ADMIN_PASSWORD=change-me-to-a-long-password

# Only these networks may open the admin page (IPs or CIDRs), e.g. your home network or VPN
# PASSAUTH_ADMIN_ALLOWED_NETWORKS=192.168.1.0/24
# Public address; needed for email links and security keys (two-step login)
# DOMAIN=https://vault.example.com
# PostgreSQL instead of the built-in SQLite
# DATABASE_URL=postgres://user:password@db:5432/passauth
# Behind a reverse proxy: the header that carries the real client IP
# IP_HEADER=X-Real-IP
# Proxies allowed to set that header (IPs or CIDRs; default: private networks)
# TRUSTED_PROXIES=172.16.0.0/12
