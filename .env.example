# ---------------------------------------------------------------- container
# Image tag to run (a version like 1.2.3, or latest).
PASSAUTH_VERSION=latest
# Host port.
PASSAUTH_PORT=8080
# User/group the container runs as. ./data must be owned by this uid:gid.
PUID=1000
PGID=1000

# ------------------------------------------------------------------- server
# Public URL users open (used in email links). No trailing slash.
DOMAIN=https://vault.example.com

# SQLite (default) or PostgreSQL, e.g.
# DATABASE_URL=postgres://passauth:secret@db:5432/passauth
# DATABASE_URL=sqlite:///data/passauth.db?mode=rwc

# Behind a reverse proxy, the header carrying the real client IP (rate limiting).
# IP_HEADER=X-Real-IP

LOG_LEVEL=info
# LOG_FORMAT=json

# Website icons for vault items (GET /api/icons/{host}).
# internal = the server fetches favicons itself; off = disabled (clients show letter avatars).
# Privacy: the server learns which sites' icons are requested, never vault contents.
# ICON_SERVICE=internal
# Icon cache directory. Default: icons/ next to the SQLite file (e.g. /data/icons);
# with PostgreSQL and no value set, icons are cached in memory.
# ICON_CACHE_DIR=/data/icons

# ------------------------------------------------------------- registration
SIGNUPS_ALLOWED=true
# Comma-separated domains allowed to self-register (empty = any).
# SIGNUPS_DOMAINS_WHITELIST=example.com,example.org
# Require email verification before first login (defaults to true when SMTP is set).
# SIGNUPS_VERIFY=true

# -------------------------------------------------------------------- admin
# Admin page: <DOMAIN>/admin (users, invitations, sign-ups, test email).
# It is off unless ADMIN_TOKEN is set. Store only the hash of your token here.
#
# How to create an admin token (run in a terminal, in this folder):
#   1. Make up a strong token (at least 16 characters), e.g.:
#        openssl rand -base64 32
#      Keep it somewhere safe: this is what you type on the admin page.
#   2. Hash it. Either answer the prompt:
#        docker compose run --rm passauth hash-admin-token
#      or do it in one line, already escaped for this file:
#        printf '%s\n' 'YOUR-TOKEN' | docker compose run --rm -T passauth hash-admin-token 2>/dev/null | sed 's/\$/$$/g'
#   3. Put the result below as ADMIN_TOKEN=... (every $ must be written as $$),
#      then apply it with:  docker compose up -d
#   To turn the admin page off again, remove or comment out ADMIN_TOKEN.
# ADMIN_TOKEN=$$argon2id$$v=19$$m=19456,t=2,p=1$$...

# --------------------------------------------------------------------- SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# starttls | force_tls | off
# SMTP_SECURITY=starttls
# SMTP_USERNAME=passauth@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=passauth@example.com
# SMTP_FROM_NAME=PassAuth

# Any value can be read from a file instead: e.g. SMTP_PASSWORD_FILE=/run/secrets/smtp
